{
  "version": 1,
  "description": "Parallel execution example with independent tasks.",
  "run": {
    "name": "parallel-example",
    "max_concurrency": 3,
    "fail_fast": true
  },
  "tasks": [
    {
      "id": "task-a",
      "title": "Task A",
      "mode": "implement",
      "kind": "shell",
      "shell": {
        "command": "bash -lc 'echo \"A\"; sleep 1'"
      }
    },
    {
      "id": "task-b",
      "title": "Task B",
      "mode": "implement",
      "kind": "shell",
      "shell": {
        "command": "bash -lc 'echo \"B\"; sleep 1'"
      }
    },
    {
      "id": "task-c",
      "title": "Task C",
      "mode": "implement",
      "kind": "shell",
      "shell": {
        "command": "bash -lc 'echo \"C\"; sleep 1'"
      }
    }
  ]
}
