{
  "version": 1,
  "description": "Minimal plan: runs a single shell task that echoes Hello World.",
  "run": {
    "name": "hello-example",
    "max_concurrency": 1,
    "fail_fast": true
  },
  "tasks": [
    {
      "id": "hello",
      "title": "Say hello",
      "mode": "implement",
      "kind": "shell",
      "shell": {
        "command": "bash -lc 'echo \"Hello World\"'"
      }
    }
  ]
}
