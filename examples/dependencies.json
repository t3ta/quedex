{
  "version": 1,
  "description": "Dependency example: tasks run in a fixed order using deps.",
  "run": {
    "name": "dependency-example",
    "max_concurrency": 2,
    "fail_fast": true
  },
  "tasks": [
    {
      "id": "step-1",
      "title": "Step 1",
      "mode": "implement",
      "kind": "codex",
      "codex": {
        "prompt": "Echo 'step 1' message"
      }
    },
    {
      "id": "step-2",
      "title": "Step 2",
      "mode": "implement",
      "deps": ["step-1"],
      "kind": "codex",
      "codex": {
        "prompt": "Echo 'step 2' message"
      }
    },
    {
      "id": "step-3",
      "title": "Step 3",
      "mode": "implement",
      "deps": ["step-2"],
      "kind": "codex",
      "codex": {
        "prompt": "Echo 'step 3' message"
      }
    }
  ]
}
