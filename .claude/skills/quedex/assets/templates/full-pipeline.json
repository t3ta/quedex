{
  "version": 1,
  "run": {
    "name": "feature-implementation",
    "max_concurrency": 2,
    "fail_fast": true
  },
  "tasks": [
    {
      "id": "research",
      "mode": "research",
      "codex": {
        "prompt": "既存の実装を調査して、パターンとベストプラクティスを把握して",
        "output_last_message": "artifacts/research.md"
      }
    },
    {
      "id": "implement-core",
      "mode": "implement",
      "deps": ["research"],
      "locks": ["workspace"],
      "codex": { "prompt": "artifacts/research.md の調査結果を踏まえて、コア機能を実装して" }
    },
    {
      "id": "implement-tests",
      "mode": "implement",
      "deps": ["implement-core"],
      "locks": ["workspace"],
      "codex": { "prompt": "実装したコア機能のテストコードを作成して" }
    },
    {
      "id": "verify",
      "mode": "verify",
      "deps": ["implement-tests"],
      "locks": ["workspace"],
      "codex": { "prompt": "npm run build && npm test && npm run lint を実行して、失敗があれば修正して" }
    }
  ]
}
